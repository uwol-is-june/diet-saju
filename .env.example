# =============================================================
#  diet-saju 환경변수 템플릿
#  - 이 파일(.env.example)만 git에 커밋된다. 실제 값은 절대 넣지 말 것.
#  - 로컬: 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 gitignore 됨)
#  - 배포: Vercel Dashboard > Project > Settings > Environment Variables 에 등록.
#  - NEXT_PUBLIC_ 접두사는 브라우저로 노출된다. 키/시크릿에는 절대 붙이지 말 것.
# =============================================================

# [필수] Google AI Studio 에서 발급 (https://aistudio.google.com/apikey)
# 무료 등급(Free tier) 키로도 동작한다. 서버에서만 사용되며 클라이언트로 전달되지 않는다.
GEMINI_API_KEY=

# [선택] 사용할 Gemini 모델. 기본값: gemini-3.5-flash-lite
# 무료 등급 일일 한도(RPD)가 모델마다 크게 다르다 — Lite 계열 500, 나머지 Flash 20.
# 바꾸기 전에 https://aistudio.google.com/rate-limit 에서 한도를 확인할 것.
# 주의: gemini-2.5-* 는 신규 키에 제공되지 않는다 (404).
GEMINI_MODEL=gemini-3.5-flash-lite

# [선택] IP 당 분당 허용 요청 수. 기본값: 5
RATE_LIMIT_PER_MINUTE=5

# [선택] 유형별 조회수·좋아요 카운터 (TASK-51). Upstash Redis.
# Vercel Dashboard > Storage > Upstash Redis 를 프로젝트에 연결하면 자동으로 주입된다.
# 둘 다 없으면 카운터가 꺼진 채로 동작한다 — 숫자 자리만 사라지고 서비스는 그대로다.
# 한쪽만 있으면 설정 실수로 보고 끈다(서버 로그에 남는다).
# 연결 여부는 /admin 에서 확인한다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── 카드뉴스 이미지 생성 (docs/cardnews) ──────────────────────
#  웹 서비스가 아니라 로컬에서 카드뉴스 이미지를 뽑을 때만 쓰는 도구용 키다.
#  Vercel 환경변수에 등록하지 않는다 — 배포된 앱은 이 값을 읽지 않는다.
# =============================================================

# [선택] 위 GEMINI_API_KEY 와 반드시 다른 Google 프로젝트에서 발급한다.
# 결제는 키가 아니라 프로젝트 단위로 붙는다. 같은 프로젝트 키를 재사용하면
# 나중에 이미지 생성에 결제를 붙일 때 서비스 키까지 유료 등급이 되고,
# app/privacy/page.tsx 가 근거로 삼는 "무료 등급" 전제가 흔들린다.
CARDNEWS_API_KEY=

# [선택] 이미지 생성 모델. 기본값: gemini-3.1-flash-lite-image
# 무료 등급이면 Lite 계열을 쓴다 — 본문 모델과 같은 이유로 RPD 차이가 크다.
# 쓸 수 있는 모델은 키마다 다르므로 목록으로 확인할 것:
#   (Invoke-RestMethod "https://generativelanguage.googleapis.com/v1beta/models?key=$key").models
# 다만 2026-08 실측 기준 무료 등급은 이미지 모델 일일 허용량이 0 이라 호출되지 않는다.
CARDNEWS_IMAGE_MODEL=gemini-3.1-flash-lite-image

# [선택] 무료 스톡 사진 (https://www.pexels.com/api/ — 가입 즉시 발급, 결제 없음)
# docs/cardnews/fetch-photos.mjs 가 후보 사진을 받아올 때만 쓴다.
PEXELS_API_KEY=
